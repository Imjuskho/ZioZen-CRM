generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model Organization {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  users                User[]
  departments          Department[]
  accessGrants         AccessGrant[]
  invitations          Invitation[]
  sessions             Session[]
  exportJobs           ExportJob[]
  legalName            String?
  defaultCurrency      String        @default("USD")
  timezone             String        @default("UTC")
  locale               String        @default("en-US")
  dateFormat           String        @default("yyyy-MM-dd")
  fiscalYearStartMonth Int           @default(1)
  businessHours        Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model ExportJob {
  id             String       @id @default(cuid())
  organizationId String
  requestedById  String
  includeAudit   Boolean      @default(true)
  status         String       @default("queued")
  progress       Int          @default(0)
  recordCount    Int          @default(0)
  payload        Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model Invitation {
  id             String       @id @default(cuid())
  token          String       @unique
  email          String
  role           Role         @default(MEMBER)
  organizationId String
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([token, acceptedAt])
}

model AccessGrant {
  id             String        @id @default(cuid())
  userId         String
  permission     String
  departmentId   String?
  organizationId String?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId, permission])
  @@index([organizationId, permission])
  @@index([departmentId, permission])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model User {
  id                                String                     @id @default(cuid())
  email                             String                     @unique
  passwordHash                      String
  firstName                         String
  lastName                          String
  role                              Role                       @default(MEMBER)
  active                            Boolean                    @default(true)
  organizationId                    String?
  organization                      Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accessGrants                      AccessGrant[]
  sentInvitations                   Invitation[]               @relation("InvitationSender")
  memberships                       UserDepartment[]
  auditLogs                         AuditLog[]
  customerNotes                     CustomerNote[]             @relation("AuthoredCustomerNotes")
  taskComments                      TaskComment[]              @relation("AuthoredTaskComments")
  requestedTickets                  Ticket[]                   @relation("RequestedTickets")
  assignedTickets                   Ticket[]                   @relation("AssignedTickets")
  ticketReplies                     TicketReply[]              @relation("AuthoredTicketReplies")
  expenses                          Expense[]                  @relation("AuthoredExpenses")
  webhooks                          Webhook[]                  @relation("AuthoredWebhooks")
  ownedLeads                        Lead[]                     @relation("OwnedLeads")
  knowledgeArticles                 KnowledgeArticle[]         @relation("AuthoredKnowledgeArticles")
  calendarEvents                    CalendarEvent[]
  ownedProjects                     Project[]                  @relation("ProjectOwner")
  assignedTasks                     Task[]                     @relation("TaskAssignee")
  customers                         Customer[]                 @relation("CustomerOwner")
  ownedSignals                      OperationalSignal[]        @relation("SignalOwner")
  creditNoteApplications            CreditNoteApplication[]    @relation("CreditNoteApplicationActor")
  journalEntries                    JournalEntry[]             @relation("JournalEntryPoster")
  closedAccountingPeriods           AccountingPeriod[]         @relation("AccountingPeriodClosedBy")
  reconciliationSessions            ReconciliationSession[]    @relation("ReconciliationCreatedBy")
  assignedFinanceExceptions         FinanceException[]         @relation("FinanceExceptionAssignee")
  resolvedFinanceExceptions         FinanceException[]         @relation("FinanceExceptionResolver")
  reconciliationMatches             ReconciliationMatch[]      @relation("ReconciliationMatchActor")
  reconciliationSuggestionDecisions ReconciliationSuggestion[] @relation("ReconciliationSuggestionDecider")
  financeExceptionPolicies          FinanceExceptionPolicy[]   @relation("FinanceExceptionPolicyAssignee")
  escalatedFinanceExceptions        FinanceException[]         @relation("FinanceExceptionEscalatedTo")
  periodSignOffs                    PeriodSignOff[]            @relation("PeriodSignOffActor")
  employeeProfile                   EmployeeProfile?
  ownedGoals                        Goal[]                     @relation("GoalOwner")
  ownedAppointments                 Appointment[]              @relation("AppointmentOwner")
  createdAt                         DateTime                   @default(now())
  updatedAt                         DateTime                   @updatedAt
  sessions                          Session[]
}

model Department {
  id                       String                   @id @default(cuid())
  name                     String                   @unique
  slug                     String                   @unique
  description              String?
  organizationId           String?
  organization             Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accessGrants             AccessGrant[]
  branding                 Json?
  memberships              UserDepartment[]
  projects                 Project[]
  tasks                    Task[]
  invoices                 Invoice[]
  customers                Customer[]
  tickets                  Ticket[]
  expenses                 Expense[]
  recurringInvoices        RecurringInvoice[]
  leads                    Lead[]
  estimates                Estimate[]
  proposals                Proposal[]
  creditNotes              CreditNote[]
  subscriptions            Subscription[]
  contracts                Contract[]
  events                   CalendarEvent[]
  signals                  OperationalSignal[]
  signalRules              SignalRule[]
  accounts                 Account[]
  journalEntries           JournalEntry[]
  accountingPeriods        AccountingPeriod[]
  reconciliationSessions   ReconciliationSession[]
  financeExceptions        FinanceException[]
  financeExceptionPolicies FinanceExceptionPolicy[]
  employeeProfiles         EmployeeProfile[]
  leaveRequests            LeaveRequest[]
  approvalRequests         ApprovalRequest[]
  payrollBatches           PayrollBatch[]
  automationRules          AutomationRule[]
  inboxChannels            InboxChannel[]
  inboxThreads             InboxThread[]
  recurringTasks           RecurringTask[]
  goals                    Goal[]
  appointments             Appointment[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

model UserDepartment {
  userId       String
  departmentId String
  isPrimary    Boolean    @default(false)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
}

model Customer {
  id                String                 @id @default(cuid())
  name              String
  email             String?
  phone             String?
  company           String?
  notes             String?
  departmentId      String
  department        Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId           String?
  owner             User?                  @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projects          Project[]
  tasks             Task[]
  invoices          Invoice[]
  customerNotes     CustomerNote[]
  contacts          Contact[]
  portalAccount     CustomerPortalAccount?
  recurringInvoices RecurringInvoice[]
  estimates         Estimate[]
  proposals         Proposal[]
  creditNotes       CreditNote[]
  subscriptions     Subscription[]
  contracts         Contract[]
  tickets           Ticket[]
  signals           OperationalSignal[]
  leads             Lead[]
  inboxThreads      InboxThread[]
  appointments      Appointment[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([departmentId])
  @@index([ownerId])
}

model CustomerPortalAccount {
  id           String    @id @default(cuid())
  customerId   String    @unique
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
}

model Project {
  id           String          @id @default(cuid())
  name         String
  description  String?
  status       String          @default("active")
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ownerId      String?
  owner        User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks        Task[]
  milestones   TaskMilestone[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([departmentId])
  @@index([ownerId])
}

model Session {
  id             String        @id
  userId         String
  organizationId String?
  deviceLabel    String?
  ipAddress      String?
  userAgent      String?
  lastSeenAt     DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId, revokedAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  action         String
  entityType     String
  entityId       String?
  departmentId   String?
  metadata       Json?
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([departmentId])
  @@index([entityType])
  @@index([actorId])
  @@index([action, createdAt])
}

model Account {
  id                     String                  @id @default(cuid())
  code                   String
  name                   String
  type                   AccountType
  currency               String                  @default("USD")
  description            String?
  active                 Boolean                 @default(true)
  departmentId           String
  department             Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  journalLines           JournalLine[]
  reconciliationSessions ReconciliationSession[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId, type])
}

model JournalEntry {
  id                        String                     @id @default(cuid())
  number                    String                     @unique
  date                      DateTime                   @default(now())
  memo                      String?
  departmentId              String
  department                Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  postedById                String?
  postedBy                  User?                      @relation("JournalEntryPoster", fields: [postedById], references: [id], onDelete: SetNull)
  accountingPeriodId        String?
  accountingPeriod          AccountingPeriod?          @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  reversalOfId              String?
  reversalOf                JournalEntry?              @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals                 JournalEntry[]             @relation("JournalEntryReversal")
  reconciliationMatch       ReconciliationMatch?
  reconciliationSuggestions ReconciliationSuggestion[]
  lines                     JournalLine[]
  createdAt                 DateTime                   @default(now())

  @@index([departmentId, date])
  @@index([accountingPeriodId])
  @@index([reversalOfId])
}

model AccountingPeriod {
  id             String          @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  status         String          @default("open")
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  closedAt       DateTime?
  closedById     String?
  closedBy       User?           @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]
  signOffs       PeriodSignOff[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId, startDate, endDate])
}

model ReconciliationSession {
  id             String            @id @default(cuid())
  name           String
  statementStart DateTime
  statementEnd   DateTime
  openingBalance Decimal           @db.Decimal(15, 2)
  closingBalance Decimal?          @db.Decimal(15, 2)
  status         String            @default("open")
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User              @relation("ReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions   BankTransaction[]
  createdAt      DateTime          @default(now())
  closedAt       DateTime?

  @@index([departmentId, status])
  @@index([accountId, statementEnd])
}

model BankTransaction {
  id              String                     @id @default(cuid())
  sessionId       String
  session         ReconciliationSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  externalId      String
  transactionDate DateTime
  amount          Decimal                    @db.Decimal(15, 2)
  description     String?
  status          String                     @default("unmatched")
  source          String                     @default("manual")
  rawData         Json?
  match           ReconciliationMatch?
  suggestions     ReconciliationSuggestion[]
  createdAt       DateTime                   @default(now())

  @@unique([sessionId, externalId])
  @@index([sessionId, status])
}

model ReconciliationMatch {
  id                String          @id @default(cuid())
  bankTransactionId String          @unique
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  journalEntryId    String          @unique
  journalEntry      JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  amount            Decimal         @db.Decimal(15, 2)
  matchedById       String
  matchedBy         User            @relation("ReconciliationMatchActor", fields: [matchedById], references: [id], onDelete: Restrict)
  matchedAt         DateTime        @default(now())
}

model ReconciliationSuggestion {
  id                String          @id @default(cuid())
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  journalEntryId    String
  journalEntry      JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  score             Int
  reason            String
  status            String          @default("pending")
  decidedById       String?
  decidedBy         User?           @relation("ReconciliationSuggestionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  createdAt         DateTime        @default(now())

  @@unique([bankTransactionId, journalEntryId])
  @@index([bankTransactionId, status])
}

model FinanceExceptionPolicy {
  id             String     @id @default(cuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  type           String?
  severity       String?
  thresholdHours Int
  assigneeId     String?
  assignee       User?      @relation("FinanceExceptionPolicyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([departmentId, active])
}

model FinanceException {
  id              String     @id @default(cuid())
  type            String
  severity        String     @default("medium")
  status          String     @default("open")
  title           String
  detail          String
  entityType      String?
  entityId        String?
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assigneeId      String?
  assignee        User?      @relation("FinanceExceptionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedById    String?
  resolvedBy      User?      @relation("FinanceExceptionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolutionNote  String?
  escalationLevel Int        @default(0)
  escalatedAt     DateTime?
  escalatedToId   String?
  escalatedTo     User?      @relation("FinanceExceptionEscalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([departmentId, status, severity])
  @@index([entityType, entityId])
}

model PeriodSignOff {
  id                 String           @id @default(cuid())
  accountingPeriodId String
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Cascade)
  status             String
  actorId            String
  actor              User             @relation("PeriodSignOffActor", fields: [actorId], references: [id], onDelete: Restrict)
  note               String?
  snapshot           Json
  createdAt          DateTime         @default(now())

  @@index([accountingPeriodId, createdAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)

  @@index([accountId])
}

model Invoice {
  id                 String                  @id @default(cuid())
  number             String                  @unique
  amount             Decimal                 @db.Decimal(12, 2)
  currency           String                  @default("USD")
  status             String                  @default("draft")
  departmentId       String
  department         Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ownerId            String?
  notes              String?
  payments           Payment[]
  items              InvoiceItem[]
  creditApplications CreditNoteApplication[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([departmentId])
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
}

model CustomerNote {
  id         String   @id @default(cuid())
  body       String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull, name: "AuthoredCustomerNotes")
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([authorId])
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  method        String?
  transactionId String?
  paymentDate   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("AuthoredTaskComments", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([authorId])
}

model Ticket {
  id           String        @id @default(cuid())
  subject      String
  message      String?
  status       String        @default("open")
  priority     String        @default("normal")
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requesterId  String?
  requester    User?         @relation("RequestedTickets", fields: [requesterId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?         @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  replies      TicketReply[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([assigneeId])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("AuthoredTicketReplies", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

model CustomField {
  id         String             @id @default(cuid())
  entityType String
  name       String
  label      String
  fieldType  String
  required   Boolean            @default(false)
  options    Json?
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  values     CustomFieldValue[]

  @@unique([entityType, name])
  @@index([entityType])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityType    String
  entityId      String
  value         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, entityId])
  @@index([entityType, entityId])
}

model RecurringInvoice {
  id           String     @id @default(cuid())
  numberPrefix String     @default("RI")
  amount       Decimal    @db.Decimal(12, 2)
  currency     String     @default("USD")
  interval     String     @default("monthly")
  status       String     @default("active")
  nextRunAt    DateTime
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId      String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([nextRunAt])
}

model Expense {
  id           String     @id @default(cuid())
  amount       Decimal    @db.Decimal(12, 2)
  currency     String     @default("USD")
  category     String
  description  String?
  expenseDate  DateTime   @default(now())
  vendor       String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId      String?
  owner        User?      @relation("AuthoredExpenses", fields: [ownerId], references: [id], onDelete: SetNull)
  receiptPath  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([category])
  @@index([expenseDate])
}

model TaskMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime?
  cost        Decimal?  @db.Decimal(12, 2)
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([dueDate])
}

model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  events    String[]
  secret    String?
  active    Boolean  @default(true)
  ownerId   String?
  owner     User?    @relation("AuthoredWebhooks", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  message   String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Estimate {
  id                 String         @id @default(cuid())
  number             String         @unique
  status             String         @default("draft")
  total              Decimal        @db.Decimal(12, 2)
  currency           String         @default("USD")
  validUntil         DateTime?
  notes              String?
  items              EstimateItem[]
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  departmentId       String
  department         Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId            String?
  convertedInvoiceId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([customerId])
}

model Proposal {
  id           String     @id @default(cuid())
  number       String     @unique
  title        String
  status       String     @default("draft")
  total        Decimal    @db.Decimal(12, 2)
  currency     String     @default("USD")
  publicToken  String     @unique @default(cuid())
  viewedAt     DateTime?
  acceptedAt   DateTime?
  notes        String?
  content      String?
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([customerId])
}

model CreditNote {
  id               String                  @id @default(cuid())
  number           String                  @unique
  status           String                  @default("draft")
  total            Decimal                 @db.Decimal(12, 2)
  currency         String                  @default("USD")
  notes            String?
  customerId       String?
  customer         Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  relatedInvoiceId String?
  departmentId     String
  department       Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId          String?
  applications     CreditNoteApplication[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([customerId])
}

model CreditNoteApplication {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(12, 2)
  appliedAt    DateTime   @default(now())
  actorId      String?
  actor        User?      @relation("CreditNoteApplicationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
  @@index([invoiceId])
  @@index([appliedAt])
}

model Subscription {
  id              String     @id @default(cuid())
  name            String
  amount          Decimal    @db.Decimal(12, 2)
  currency        String     @default("USD")
  interval        String     @default("monthly")
  status          String     @default("active")
  startDate       DateTime   @default(now())
  nextBillingDate DateTime
  endDate         DateTime?
  notes           String?
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([nextBillingDate])
}

model Contract {
  id           String     @id @default(cuid())
  subject      String
  value        Decimal?   @db.Decimal(12, 2)
  status       String     @default("draft")
  startDate    DateTime?
  endDate      DateTime?
  content      String?
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([status])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String?
  published Boolean  @default(false)
  authorId  String?
  author    User?    @relation("AuthoredKnowledgeArticles", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model CalendarEvent {
  id           String      @id @default(cuid())
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime?
  reminderAt   DateTime?
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([startsAt])
  @@index([ownerId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  rate        Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model EstimateItem {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  rate        Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estimateId])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Lead {
  id           String      @id @default(cuid())
  title        String
  source       String?
  status       String      @default("new")
  value        Decimal?    @db.Decimal(12, 2)
  ownerId      String?
  owner        User?       @relation("OwnedLeads", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([ownerId])
}

model Task {
  id           String        @id @default(cuid())
  title        String
  description  String?
  status       String        @default("open")
  priority     String        @default("normal")
  dueAt        DateTime?
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  comments     TaskComment[]

  @@index([departmentId])
  @@index([projectId])
  @@index([assigneeId])
}

model OperationalSignal {
  id              String           @id @default(cuid())
  type            String
  severity        String           @default("medium")
  status          String           @default("open")
  title           String
  explanation     String
  entityType      String
  entityId        String
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  departmentId    String
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?            @relation("SignalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueAt           DateTime?
  snoozedUntil    DateTime?
  resolvedAt      DateTime?
  resolution      String?
  dismissalReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  evidence        SignalEvidence[]
  actions         SignalAction[]

  @@index([departmentId, status])
  @@index([entityType, entityId])
  @@index([customerId])
  @@index([ownerId])
}

model SignalEvidence {
  id            String            @id @default(cuid())
  signalId      String
  signal        OperationalSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  sourceType    String
  sourceId      String
  metric        String
  observedValue String
  expectedValue String?
  capturedAt    DateTime          @default(now())

  @@index([signalId])
}

model SignalAction {
  id          String            @id @default(cuid())
  signalId    String
  signal      OperationalSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  actionType  String
  actorId     String?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([signalId])
}

model SignalRule {
  id             String     @id @default(cuid())
  type           String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  enabled        Boolean    @default(true)
  thresholdHours Int?
  cooldownHours  Int        @default(24)
  updatedById    String?
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())

  @@unique([type, departmentId])
  @@index([departmentId])
}

model EmployeeProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle       String
  employmentType String         @default("full_time")
  hourlyRate     Decimal?       @db.Decimal(10, 2)
  salary         Decimal?       @db.Decimal(15, 2)
  startDate      DateTime
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  leaveRequests  LeaveRequest[]
  payslips       Payslip[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([departmentId])
}

model LeaveRequest {
  id           String          @id @default(cuid())
  employeeId   String
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String          @default("pending")
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([departmentId, status])
  @@index([employeeId])
}

model ApprovalRequest {
  id            String     @id @default(cuid())
  entityType    String
  entityId      String
  requestedById String
  stepOrder     Int        @default(1)
  requiredRole  String?
  status        String     @default("pending")
  approvedById  String?
  decidedAt     DateTime?
  decisionNote  String?
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([departmentId, status])
  @@index([entityType, entityId])
}

model PayrollBatch {
  id           String     @id @default(cuid())
  name         String
  periodStart  DateTime
  periodEnd    DateTime
  status       String     @default("draft")
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  lockedAt     DateTime?
  exportedAt   DateTime?
  exportReference String?
  payslips     Payslip[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId, status])
}

model Payslip {
  id              String          @id @default(cuid())
  payrollBatchId  String
  payrollBatch    PayrollBatch    @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  periodStart     DateTime
  periodEnd       DateTime
  grossAmount     Decimal         @db.Decimal(15, 2)
  bonusAmount     Decimal         @default(0) @db.Decimal(15, 2)
  deductionAmount Decimal         @default(0) @db.Decimal(15, 2)
  netAmount       Decimal         @db.Decimal(15, 2)
  status          String          @default("draft")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([payrollBatchId, employeeId])
  @@index([employeeId])
}

model AutomationRule {
  id           String          @id @default(cuid())
  name         String
  eventType    String
  enabled      Boolean         @default(true)
  conditions   Json?
  action       Json
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([departmentId, eventType, enabled])
}

model AutomationRun {
  id           String         @id @default(cuid())
  ruleId       String
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventId      String
  eventPayload Json
  status       String         @default("completed")
  attempts     Int            @default(0)
  nextRetryAt  DateTime?
  deadLetteredAt DateTime?
  result       Json?
  error        String?
  createdAt    DateTime       @default(now())
  @@unique([ruleId, eventId])
  @@index([createdAt])
  @@index([status, nextRetryAt])
}

model InboxChannel {
  id           String     @id @default(cuid())
  channel      String
  secret       String
  active       Boolean    @default(true)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdById  String
  createdAt    DateTime   @default(now())

  @@unique([channel, departmentId])
  @@index([departmentId, active])
}

model InboxThread {
  id            String         @id @default(cuid())
  channel       String
  externalId    String?
  subject       String
  status        String         @default("open")
  externalEmail String?
  externalPhone String?
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages      InboxMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([departmentId, status])
  @@index([customerId])
  @@index([channel, externalId])
}

model InboxMessage {
  id         String      @id @default(cuid())
  threadId   String
  thread     InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction  String
  sender     String
  body       String
  externalId String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@unique([threadId, externalId])
  @@index([threadId, createdAt])
}

model RecurringTask {
  id           String     @id @default(cuid())
  title        String
  description  String?
  frequency    String
  nextRunAt    DateTime
  active       Boolean    @default(true)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assigneeId   String?
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId, active, nextRunAt])
}

model Goal {
  id           String      @id @default(cuid())
  title        String
  description  String?
  periodStart  DateTime
  periodEnd    DateTime
  status       String      @default("active")
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  ownerId      String?
  owner        User?       @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  keyResults   KeyResult[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId, status])
  @@index([ownerId])
}

model KeyResult {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  target    Decimal  @db.Decimal(15, 2)
  current   Decimal  @default(0) @db.Decimal(15, 2)
  unit      String   @default("count")
  status    String   @default("on_track")
  updatedAt DateTime @updatedAt

  @@index([goalId, status])
}

model Appointment {
  id           String     @id @default(cuid())
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  status       String     @default("scheduled")
  location     String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User       @relation("AppointmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attendees    Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId, startsAt])
  @@index([ownerId, startsAt])
  @@index([customerId])
}
